{
  "name": "webauthn-server-buildkit",
  "version": "2.3.1",
  "description": "Framework-independent WebAuthn server for Node.js — passkeys, attestation, encrypted sessions.",
  "author": "Ahsan Mahmood <aoneahsan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/webauthn-server-buildkit.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/webauthn-server-buildkit/issues"
  },
  "homepage": "https://webauthn-server-buildkit-docs.aoneahsan.com",
  "funding": {
    "type": "individual",
    "url": "https://aoneahsan.com/payment?project-id=webauthn-server-buildkit&project-identifier=webauthn-server-buildkit"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "webauthn",
    "passkeys",
    "fido2",
    "biometric",
    "authentication",
    "passwordless",
    "attestation",
    "security",
    "typescript",
    "server"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AI-INTEGRATION-GUIDE.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "yarn build",
    "prepublishOnly": "yarn lint && yarn typecheck"
  },
  "dependencies": {
    "cbor-x": "^1.6.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
